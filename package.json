{
  "name": "allstartcg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulateur d'ouverture de boosters de tous les TCG — gratuit, sans achat.",
  "scripts": {
    "start": "node server.mjs",
    "fetch": "node scripts/fetch-data.mjs && node scripts/build-index.mjs",
    "discover": "node scripts/discover-sets.mjs",
    "packs": "node scripts/fetch-packs.mjs",
    "rates": "node scripts/simulate-rates.mjs",
    "index": "node scripts/build-index.mjs",
    "pokedex": "node scripts/fetch-pokedex.mjs",
    "logos": "node scripts/fetch-logos.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
